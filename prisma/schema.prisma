generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  role         String    @default("ADMIN")

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

model CandidateSubmission {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String
  dob                String?
  qualification      String?
  qualificationYear  String?
  pursuingDegree     String?
  position           String?
  totalExperience    String?
  relevantExperience String?
  currentLocation    String?
  relocate           String?
  travelAbroad       String?
  passport           String?
  visa               String?
  currentlyWorking   String?
  reasonForChange    String?  @db.Text
  currentCtc         String?
  inHandSalary       String?
  expectedCtc        String?
  expectedInHand     String?
  noticePeriod       String?
  earliestJoinDate   String?
  dependents         String?
  readyOnCurrentCtc  String?
  resumeUrl          String?
  createdAt          DateTime @default(now())

  @@map("candidate_submissions")
}

model Service {
  id          String   @id @default(cuid())
  tag         String?
  title       String
  description String   @db.Text
  image       String
  href        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  slug        String   @unique

  bannerImage     String?
  darkBannerImage String?

  benefits   Json?
  challenges Json?
  closing    String? @db.Text
  coverage   Json?
  gradient   String?
  intro      Json?
  middle     Json?
  qa         Json?
  sections   Json?

  brochureGradientFrom String?
  brochureGradientTo   String?
  brochureGradientVia  String?

  @@index([slug])
  @@index([isActive])
  @@index([order])
  @@map("services")
}

model Product {
  id                   String            @id @default(cuid())
  title                String
  slug                 String            @unique
  bannerImage          String?
  shortDescription     String?           @db.Text
  description          String?           @db.Text
  features             Json?
  benefits             Json?
  sections             Json?
  faqs                 Json?
  brochureUrl          String?
  isActive             Boolean           @default(true)
  order                Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cardSecondaryText    String?
  cardTagline          String?
  flipDescription      String?           @db.Text
  flipEyebrow          String?
  flipTitle            String?
  logoImage            String?
  brochureGradientFrom String?
  brochureGradientTo   String?
  brochureGradientVia  String?
  brochureRequests     BrochureRequest[]

  @@map("products")
}

model BrochureRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String
  company   String?
  website   String?
  productId String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product? @relation(fields: [productId], references: [id])

  @@index([email])
  @@index([productId])
  @@index([status])
  @@map("brochure_requests")
}

model JobOpening {
  id          String   @id @default(cuid())
  title       String
  department  String?
  location    String?
  type        String?
  description String   @db.Text
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("job_openings")
}

model Application {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  resumeUrl String?
  openingId String?
  createdAt DateTime @default(now())

  @@map("applications")
}

model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  address      String   @db.Text
  source       String?
  requirements String?  @db.Text
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String
  category  String
  featured  Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@map("Client")
}

model Media {
  id        String   @id
  fileName  String
  url       String
  type      String   @default("OTHER")
  folder    String?
  altText   String?
  relatedId String?
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([relatedId])
  @@index([type])
  @@map("Media")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  quote     String   @db.Text
  name      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@map("Testimonial")
}

model CaseStudy {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  clientName       String?
  industry         String?
  shortDescription String   @db.Text
  description      String?  @db.Text
  image            String?
  challenge        String?  @db.Text
  solution         String?  @db.Text
  results          String?  @db.Text
  technologies     Json?
  projectUrl       String?
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([order])
  @@map("case_studies")
}

model ProductSolution {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  projectTag      String?
  cardBackTitle   String?
  excerpt         String?  @db.Text
  content         String?  @db.LongText
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  logoImage       String?
  bannerImage     String?
  metaTitle       String?
  metaDescription String?  @db.Text
  keywords        String?
  canonicalUrl    String?
  openGraphImage  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  benefits        Json?
  highlightCards  Json?
  benefitsTitle   String?
  contentSections Json?
  sidebarImage    String?

  @@index([slug])
  @@index([isActive])
  @@index([order])
  @@map("product_solutions")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  content         String    @db.LongText
  featuredImage   String?
  category        String?
  author          String?
  tags            Json?
  isPublished     Boolean   @default(false)
  isFeatured      Boolean   @default(false)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?   @db.Text
  keywords        String?
  openGraphImage  String?
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([order])
  @@map("blog_posts")
}
