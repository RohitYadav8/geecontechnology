generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model CandidateSubmission {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String
  dob                String?
  qualification      String?
  qualificationYear  String?
  pursuingDegree     String?
  position           String?
  totalExperience    String?
  relevantExperience String?
  currentLocation    String?
  relocate           String?
  travelAbroad       String?
  passport           String?
  visa               String?
  currentlyWorking   String?
  reasonForChange    String?  @db.Text
  currentCtc         String?
  inHandSalary       String?
  expectedCtc        String?
  expectedInHand     String?
  noticePeriod       String?
  earliestJoinDate   String?
  dependents         String?
  readyOnCurrentCtc  String?
  resumeUrl          String?
  createdAt          DateTime @default(now())

  @@map("candidate_submissions")
}

model Service {
  id          String   @id @default(cuid())
  tag         String?
  title       String
  description String   @db.Text
  image       String
  href        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Product {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  bannerImage      String?
  shortDescription String? @db.Text
  description      String? @db.Text

  features Json?
  benefits Json?
  sections Json?
  faqs     Json?

  brochureUrl String?
  isActive    Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
  brochureRequests BrochureRequest[]
}
model BrochureRequest {
  id        String   @id @default(cuid())

  name      String
  phone     String
  email     String
  company   String?
  website   String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  status    String   @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([productId])
  @@index([status])
  @@map("brochure_requests")
}
model Testimonial {
  id        Int      @id @default(autoincrement())
  quote     String   @db.Text
  name      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Client {
  id          Int      @id @default(autoincrement())
  name        String
  logo        String
  category    String
  featured    Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}